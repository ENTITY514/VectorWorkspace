		function loadTree(selector, url)
		{
			$.getJSON(url, function(data){
				var r = /^(\d*?)(|0{3}|0{6}|0{9})$/;
				var fullCode = {};
				var shortCode = {};
				var topLevel = {};

				for(var i = 0,l = data.length; i < l; i++)
				{
					var d = data[i];
					var m = r.exec(d.code);
					d.level = m[1].length / 3;
					fullCode[d.code] = d;
				}

				function node(code, level)
				{
					var n = fullCode[code];
					level = level || n.level;
					var key = level + "_" + code.substr(0, level * 3);

					if(shortCode[key]) return shortCode[key];

					shortCode[key] = n;
					if(!n.key) n.key = key;

					if(level > 1)
					{
						var p = node(code.substr(0, (level - 1) * 3) + '000000000000!'.substr(0, (5 - level) * 3), level - 1);
						if(p.code != n.code)
						{
							n.parent = p;
							p.children = p.children || {};
							p.children[n.key] = n;
						}
					}
					else topLevel[n.key] = n;

					return n;
				}

				for(i = 0,l = data.length; i < l; i++)
					node(data[i].code);

				var $tree = $(selector);
				$tree.data("data", {
					all: data,
					fullCode: fullCode,
					shortCode: shortCode,
					children: topLevel
				});

				updateTree($tree.children('ul'));

				$tree.on('click', '.collapse', function()
				{
					var data = $tree.data("data");
					var $this = $(this);
					var $label = $this.closest('label');
					var d = data.shortCode[$label.data('code')];
					if(d.collapsed === false)
					{
						$label.next('ul').remove();
						$this.removeClass('collapse-off');
						d.collapsed = true;
					}
					else
					{
						var model = $tree.data('model') || {};
						$label.parent().append("<ul>"+renderTree(d, model)+"</ul>");
						$this.addClass('collapse-off');
						d.collapsed = false;
					}
					return false;
				});
			});
		}

		function checked(d, model)
		{
			if(model[d.key]) return d.key;
			if(!d.parent) return null;
			if(model[d.parent.key]) return d.parent.key;
			if(!d.parent.parent) return null;
			if(model[d.parent.parent.key]) return d.parent.parent.key;
			if(!d.parent.parent.parent) return null;
			if(model[d.parent.parent.parent.key]) return d.parent.parent.parent.key;
			return null;
		}

		function renderTree(from, model)
		{
			if(!from.sortedChildren)
			{
				var values = [];
				for (var key in from.children)
					if(from.children.hasOwnProperty(key))
						values.push(from.children[key]);
				from.sortedChildren = values.sort(function (a, b) { return a.value > b.value ? 1 : -1; });
			}

			var s = [], i, l;
			for (i = 0, l = from.sortedChildren.length; i < l; i++)
			{
				var d = from.sortedChildren[i];
				if(!d.hidden)
				{
					var c = checked(d, model);
					s.push('<li><label data-code="' + d.key +'"><span class="checkbox'+
						(c ? "" : " checkbox-off" ) +'">&nbsp;</span>' +
						(d.children ? "<span class='collapse"+(d.collapsed === false ? ' collapse-off' : '')+
						"'></span>" : '') + d.value + '</label>'+
						(d.collapsed === false ? "<ul>"+renderTree(d, model)+"</ul>" : '') + '</li>');
				}
			}
			return s.join("\n");
		}

		function updateTree($element)
		{
			$element = $element || $(this);
			var $tree = $element.closest('.tree');
			var data = $tree.data("data") || { children: {} };
			var model = $tree.data('model') || {};
			var fromCode = $element.data('code');
			var from = fromCode ? data.shortCode[fromCode] : data;
			$element.html(renderTree(from, model));
		}
		

