		function filter()
		{
			var $this = $(this);

			var val = $this.val().toLowerCase();

			if($this.data('prevval') == val) return;
			$this.data('prevval', val);

			var val_trimmed = $.trim(val);
			var $tree = $this.nextAll(".tree");
			var collapsible = $tree.data("collapsible");
			var $filtered = $tree.find(".filtered");
			if(val_trimmed && ($tree[0].id != 'tree_kv' || val_trimmed.length > 2))
			{
				var r = new RegExp(escapeText4Regexp(val), "i");
				var allVisible = true;

				if(collapsible)
				{
					var data = $tree.data("data").all;
					for(var i = 0,l = data.length; i < l; i++)
					{
						data[i].collapsed = true;
						data[i].hidden = true;
					}
					for(i = 0,l = data.length; i < l; i++)
					{
						var d = data[i];
						if(r.test(d.value))
						{
							var p = d;
							do {
								p.collapsed = false;
								p.hidden = false;
								p = p.parent;
							} while(p);
						}
						else allVisible = false;
					}
					updateTree($tree.children('ul'));
				}
				else
				{
					$tree.find("label").each(function(idx, label){
						var $label = $(label);
						if($label.find('.collapse-off').length) return;
						var visible = r.test($label.text());
						$label.parent().toggle(visible);
						allVisible &= visible;
					});
				}
				$filtered.toggle(!allVisible);
			}
			else
			{
				if(collapsible)
				{
					data = $tree.data("data").all;
					for(i = 0,l = data.length; i < l; i++)
					{
						data[i].collapsed = true;
						data[i].hidden = false;
					}
					var model = $tree.data('model') || {};
					for(i = 0,l = data.length; i < l; i++)
					{
						d = data[i];
						if(model[d.key])
						{
							p = d;
							while(Boolean(p = p.parent))
								p.collapsed = false;
						}
					}
					updateTree($tree.children('ul'));
				}
				else
					$tree.find("li").show();
				$filtered.hide();
			}
		}

