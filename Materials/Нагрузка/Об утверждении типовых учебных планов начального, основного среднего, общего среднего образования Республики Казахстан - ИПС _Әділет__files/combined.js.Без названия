	(function()
	{
		var tagit = $.fn.tagit; // расширяем работу $.ui.tagIt
		$.fn.tagit = function(mode)
		{
			var args = Array.prototype.slice.call(arguments);
			var result = tagit.apply(this, args);

			var $ul = $(this);
			var $favPanel = $ul.closest('.fav_panel');

			if(!$favPanel.size())
				return result;

			var $input = $ul.find('.tagit-new input');

			if(typeof mode === 'object') // инициализация
			{
				// по нажатию ENTER завершаем редактирование тегов
				$input.on('keyup.ti', function(e)
					{
						if(e.keyCode === 13 /* ENTER */)
							$favPanel.find('.icon_apply').click();
					});
				// при клике на нерабочую область фокусируемся на INPUT
				$favPanel.on('mouseup.oti', function(e)
					{
						if(e.target === $favPanel[0])
							$input.focus();
					});
			}
			else if(mode === 'destroy')
			{
				$input.off('keyup.ti');
				$favPanel.off('mouseup.oti');
			}

			return result;
		};

		function FavoritesManager(table, popup)
		{
			this.$table = $(table);
			this.popup = popup;
			this.$popup = this.popup && $('#popup');
			this.bind();
		}
		FavoritesManager.prototype =
		{
			bind: function()
			{
				this.$table.find('.favs_edit_toggle')
					.click(this.editToggle.bind(this));

				if(this.popup)
				{
					var popup = this.popup;
					this.$popup.addClass('favorites');

					this.$table.find('.favorites_remove')
						.click(function()
						{
							popup.postBack({
								url: extractLang() + "/favorites/remove",
								data: { url: $(this).attr("href") }
							});
							return false;
						});

					this.$popup.find('#btn_add').click(function()
						{
							popup.postBack({
								url: extractLang() + "/favorites/add",
								data: { url: $(this).attr("href") }
							});
							return false;
						});

					this.tableFilter = new TableFilter(this.$popup);
				}
			},

			editToggle: function(e)
			{
				var $td = $(e.target).closest('td');
				var $panel = $td.find('.fav_panel');
				var $list = $panel.find('ul');

				if($panel.hasClass('editing'))
					this.save($td, $panel, $list);
				else
					this.edit($panel, $list);
			},

			availableTags: function()
			{
				return this.$table.find('.fav_tag').toArray()
					.map(function(domEl)
					{ 
						return $(domEl).find('.tagit-label').text() ||
						       $(domEl).text();
					})
					.reduce(function(list, el) // is unique
					{
						var tag = el.toLowerCase();
						if(list.indexOf(tag) === -1)
							list.push(tag);
						return list;
					}, []);
			},

			edit: function($panel, $list)
			{
				$panel.addClass('editing');
				$list.tagit(
					{ 
						availableTags: this.availableTags(), 
						showAutocompleteOnFocus: true,
						allowSpaces: true
					});
				$list.find('input').focus();
				this.$table.find('.filter_term').removeClass('filter_term');
			},

			view: function($panel, $list)
			{
				$panel.removeClass('editing');
