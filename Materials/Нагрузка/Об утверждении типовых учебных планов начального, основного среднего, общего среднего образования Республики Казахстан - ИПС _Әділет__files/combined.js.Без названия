			res = $.map(res, function(v){ return v.replace(r, "<q>$1</q>"); });

			var prev_pos = -1, prev_count = 0;
			for(i = 0; i < res.length; i++)
			{
				var count = res[i].match(/<q>/g).length;
				if(preview_locations[i][0] != prev_pos)
				{
					prev_count = 0;
					prev_pos = preview_locations[i][0];
				}
				preview_locations[i][2] = prev_count;
				prev_count += count;
			}

			var html = res.length ? "<ul><li>"+res.join("</li><li>")+"</li></ul>" : "<p>"+strNotFound+"</p>";

