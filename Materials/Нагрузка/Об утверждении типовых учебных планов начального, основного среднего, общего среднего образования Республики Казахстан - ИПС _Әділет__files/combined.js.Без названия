	function loadPopup(url, afterPopup)
	{
		jQuery("body").append('<div id="blackout"><div id="popup_centerer"><div id="popup"><img src="/tpl/etherna/css/img/ajax-loader.gif"></div></div></div>');
		$("body,#container").addClass('hasPopup');

		var canceled = false;
		var sending = false;
		function cancel()
		{
			canceled = true;
			jQuery("#blackout").remove();
			$("body,#container").removeClass('hasPopup');
			return false;
		}
		function displayError()
		{
			jQuery("#popup #error").show();
			jQuery("#popup #indicator").hide();
			sending = false;
		}
		function postBack(ajaxParams)
		{
			if(sending) return false;

			jQuery("#popup #error").hide();
			jQuery("#popup #indicator").show();

			sending = true;
			jQuery.ajax(jQuery.extend({}, {
				type: "POST",
				success: showPopup,
				error: displayError
			}, ajaxParams));
			return false;
		}
		function showPopup(html)
		{
			if(canceled) return;
			sending = false;

			jQuery("#popup").html(html);
			jQuery("#popup #btn_cancel").click(cancel);
			jQuery("#popup #from").val(document.URL);

			if(afterPopup) afterPopup(html);
		}

		jQuery("#popup img").click(cancel);
		jQuery.ajax({
			url: url,
			cache: false,
			success: showPopup,
			error: cancel
		});

		return {
			postBack: postBack,
			cancel: cancel
		};
	}

