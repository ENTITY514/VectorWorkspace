	function swipe(toRight)
	{
		if(toRight)
		{
			if($container.hasClass('tabs_active')) 
				$container.removeClass('tabs_active');
			else if($container.hasClass('menu_active')) {}
			else if($('span.mode_sidebar:visible').length) 
			{
				if($container.hasClass('mode_footer'))
					$container.removeClass('mode_footer').addClass('mode_sidebar');
				else if($container.hasClass('mode_sidebar'))
					$container.removeClass('mode_sidebar').addClass('mode_content');
				else $container.addClass('menu_active');
			}
			else
			{
				if($container.hasClass('mode_footer'))
					$container.removeClass('mode_footer').addClass('mode_content');
				else $container.addClass('menu_active');
			}
		}
		else
		{
			if($container.hasClass('menu_active'))
				$container.removeClass('menu_active');
			else if($container.hasClass('tabs_active')) {}
			else if($container.hasClass('mode_footer'))
			{
				if($('.tabs').length) $container.addClass('tabs_active');
			}
			else if($container.hasClass('mode_sidebar'))
				$container.removeClass('mode_sidebar').addClass('mode_footer');
			else 
			{
				if($container.hasClass('mode_content'))
					$container.removeClass('mode_content');
				$container.addClass($('span.mode_sidebar:visible').length ? 'mode_sidebar': 'mode_footer');
			}
		}
	}
	
	if('ontouchstart' in document.documentElement)
	{
		(function()
		{
			var startX = 0;
			var startY = 0;
			var endX = 0;
			var endY = 0;
			var first = false;
			var canceled = true;

			$container.bind('touchstart', function(event) 
			{
				var touches = event.originalEvent.touches;
				if(touches.length == 1)
				{
					startX = touches[0].clientX;
					startY = touches[0].clientY;
					first = true;
					canceled = false;
				}
				else canceled = true;
			});

			$container.bind('touchmove', function(event) 
			{
				var touches = event.originalEvent.touches;
				if(!canceled && touches.length == 1)
				{
					endX = touches[0].clientX;
					endY = touches[0].clientY;
					if(first && Math.abs(endX - startX) > Math.abs(endY - startY))
						event.preventDefault();
					first = false;
				}
				else canceled = true;
			});

			$container.bind('touchend', function(event)
			{
				if(first || canceled) return;
				var dx = endX - startX;
				var dy = endY - startY;
				if(Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 80) swipe(dx > 0); 
			});
		})();
	}



