		{
			if(e.ctrlKey && e.keyCode == 13 && !$("#popup").length)
			{
				var range, range2, text, textBefore, textAfter;

				var selection = (window.getSelection && window.getSelection()) ||
					(document.getSelection && document.getSelection()) || document.selection;

				if (selection.getRangeAt)
				{
					text = selection.toString();

					range = selection.getRangeAt(0);
					var start = range.startContainer;
					var end = range.endContainer;
					range2 = document.createRange();

					var $tr = $(start).closest('tr');
					range2.setStartBefore($tr.length ? $tr[0] : start);
					range2.setEnd(start, range.startOffset);
					textBefore = range2.toString();

					$tr = $(end).closest('tr');
					range2.setEndAfter($tr.length ? $tr[0] : end);
					range2.setStart(end, range.endOffset);
					textAfter = range2.toString();
				}
				else
				{
					range = selection.createRange();
					text = range.text;
					range2 = range.duplicate();
					range2.moveStart("sentence", -1);
					range2.moveEnd("character", -text.length);
					textBefore = range2.text;

					range2 = range.duplicate();
					range2.moveStart("character", text.length);
					range2.moveEnd("sentence", 1);
					textAfter = range2.text;
