						while (low <= high)
						{
							cur = Math.floor((low+high)/2);
							var cmp = $all[cur].compareDocumentPosition(start);
							//000010	2	Node B precedes Node A.
							//000100	4	Node A precedes Node B.
							if((cmp & 2)) high = cur - 1; // if a[cur] > value
							else if((cmp & 4)) low = cur + 1; // if a[cur] < value
							else break;
						}
						if(($all[cur].compareDocumentPosition(start) & 2) && cur) cur--;
					}
					else
					{
						range2 = range.duplicate();
						range2.collapse(true);
						start = range2.parentElement();

						while (low <= high)
						{
							cur = Math.floor((low+high)/2);
							if($all[cur].sourceIndex > start.sourceIndex) high = cur - 1; // if a[cur] > value
							else if($all[cur].sourceIndex < start.sourceIndex) low = cur + 1; // if a[cur] < value
							else break;
						}
						if(($all[cur].sourceIndex > start.sourceIndex) && cur) cur--;
					}

