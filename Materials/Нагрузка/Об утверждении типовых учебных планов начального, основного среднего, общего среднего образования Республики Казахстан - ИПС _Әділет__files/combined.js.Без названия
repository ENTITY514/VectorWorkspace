	var TableFilter = function(root)
	{
		this.linksMode = !!$('.module_npaLinks, .module_originChangeLinks').length;

		this.$root = $(root);
		this.$filter = this.$root.find('.filter');
		this.$table = this.$root.find('table');
		this.$filtered = this.$root.find('.filtered');
		this.$reset = this.$filtered.find('a');

		if(!$('table').length)
			this.$filter.hide();
		else
			this.bind();
	};
	TableFilter.prototype =
	{
		bind: function()
		{
			this.$filter
				.placeholder()
				.keyup(function(e)
				{
					if(e.keyCode == 27 /* escape */) 
						this.$filter.val('');

					var term = $.trim(this.$filter.val()).toLowerCase();
					this.filter(term);
				}.bind(this));
			this.$reset.click(this.reset.bind(this));
			this.$table.on('click', '.filter_term', function(e)
				{
					var term = $(e.target).text();
					this.$filter.val(term);
					this.filter(term);
				}.bind(this));
		},

		reset: function()
		{
			this.$table.data('filter', null);
			this.$table.find('tbody > tr').show();
			this.$filter.val('');
			this.$filtered.hide();
		},

		filter: function(term)
		{
			if(this.$table.data('filter') == term)
				return;
			if(!term)
				this.reset();
			else
			{
				if(term.length < 2)
					return;
				var r = new RegExp(escapeText4Regexp(term), 'i');
				var allVisible = true;
				this.$table.find('tbody > tr').each(function(idx, tr)
					{
						var $tr = $(tr);
						var text = this.linksMode ? $tr.text() : $tr.children().eq(1).text();
						var visible = r.test(text);
						$tr.toggle(visible);
						allVisible &= visible;
					});
				this.$filtered.toggle(!allVisible);
			}
			this.$table.data('filter', term);
		}
	};
