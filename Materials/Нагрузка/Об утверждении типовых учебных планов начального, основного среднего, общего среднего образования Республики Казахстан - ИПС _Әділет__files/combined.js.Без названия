            if (isEng)
				r = /^(\d\d)\/(\d\d)\/(\d{4})$/;
			else
				r = /^(\d\d)\.(\d\d)\.(\d{4})$/;
			if(!date.match(/^\d{4}-\d\d-\d\d$/))
				return r.test(date) ? (date.replace(r, isEng ? "$3-$1-$2" : "$3-$2-$1")) : "*";
			else
				return date;
		}

