			preview_query = text;

			if(text == "")
			{
				$preview.html(strPleaseEnter);
				return;
			}

			switch_links(text == query);

			var r = query_regex(text);

			var l = Math.floor((500 - text.length) / 2);
			var r2 = new RegExp("(.{0,"+l+"})("+ text + ")(.{0,"+l+"})", "ig");


			var res = [];
			preview_locations = [];
			for (var i = 0; i < $source.length; i++)
			{
				var t = $source.eq(i).text();
				if(t.match(r))
				{
