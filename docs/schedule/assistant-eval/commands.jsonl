{"id":"c18","lang":"ru","text":"у Русиной убери одиночный урок","expect":[{"command":"set_teacher_work_mode","args":{"teacher":"Русина Наталья Владимировна","lessons_per_day":{"min":2}}}]}
{"id":"c19","lang":"ru","text":"окна сверх 4 в неделю — и чем больше, тем выше штраф","expect":[{"command":"set_rule_mode","args":{"rule_code":"teacher_window_excess","mode":"soft","params":{"over":4,"progressive":true}}}]}
