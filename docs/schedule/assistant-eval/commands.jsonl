{"id":"c01","lang":"ru","text":"Мельникову Павлу Викторовичу 3 дня и только до 5-го урока","expect":[{"command":"set_teacher_work_mode","args":{"teacher":"Мельников Павел Викторович","work_days":{"mode":"exact","count":3},"periods":{"first":1,"last":5}}}]}
